<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Arka plan rengi aynı kalıyor -->
    <solid android:color="#FFD740" />

    <!-- Sadece 1dp kalınlığında siyah bir iç çizgi -->
    <stroke
        android:width="1dp"
        android:color="#000000" />

    <!-- Köşeler çok az yuvarlak (istersen 0dp yapıp tam kare bırakabilirsin) -->
    <corners android:radius="2dp" />
</shape>
